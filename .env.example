# Copy to .env before local dev or `docker compose up`. Do not commit .env.
# 代码里通过 process.env 读到的变量都列在这里。注释说明用途；带 # 的行默认不生效。

# 本地开发的 SQLite 路径。镜像和 Compose 都会改写成 file:/data/app.db。
# 容器里如果仍是相对路径 file:./data/app.db，库会写到镜像层 /app/data/app.db，换容器就丢。
# 生产进程发现自己在 Docker 里、且路径落在 /app 下时，会改写到 /data/app.db。
DATABASE_URL=file:./data/app.db

# 仅当这个用户名还不存在时，首次启动创建一个管理员。已有同名账号不改密码。
# 用户名 1–20 字符，字母、数字、下划线、连字符或中文，不能含 @ 或空白。
# 密码至少 8 位且不能含空白。任一不满足则不创建管理员。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin

# 会话 Cookie 的签名密钥，至少 32 字符。未设置或太短时，写到数据目录的 session.secret。
SESSION_SECRET=replace-with-a-random-string-of-32-plus-chars

# 网关令牌 AES-256-GCM 的口令。未设置时写到数据目录的 token.key。
# 之后更换会使已保存的令牌无法解密。
TOKEN_ENCRYPTION_KEY=replace-with-another-random-string

# 会话 Cookie 的 Secure 标志。代码读 COOKIE_SECURE。
# 不设置：X-Forwarded-Proto 为 https 时才加 Secure（宿主机 nginx 反代的情况）。
# 1：始终 Secure。0：始终不 Secure。本地 HTTP 不要设 1。
# COOKIE_SECURE=1

# 设为 1 时，启动后给第一位管理员种入本地演示网关，不需要真实 New API 令牌。默认关闭。
# DEMO_GATEWAY=1

# 后台把每个网关的渠道列表重新走一遍的间隔，毫秒。默认 300000，小于 30000 时按 30000。
# 账单调度本身另有 15 秒一次的 tick，不受这个变量控制。
# SYNC_INTERVAL_MS=300000

# 下面三个由 Next.js 或容器设置，本地 .env 通常不要写。
# NODE_ENV：生产镜像里是 production。paths.ts 用它判断是否把 SQLite 钉到 /data/app.db。
# NEXT_PHASE：Next 构建阶段会是 phase-production-build。构建时不要改写数据库路径。
# NEXT_RUNTIME：instrumentation.ts 只在 nodejs 运行时启动定时任务。
# NODE_ENV=production
# NEXT_PHASE=
# NEXT_RUNTIME=nodejs
